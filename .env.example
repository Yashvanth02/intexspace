# Supabase — content store for the admin panel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# The Storage bucket used for gallery assets and durable menu settings.
SUPABASE_STORAGE_BUCKET=Gallery

# Public under-construction gate.
#   true  — every visitor gets the under-construction page.
#           /admin and /api stay reachable so content can still be managed.
#   unset — the real site is served. Leave it unset locally and on previews.
# Set this to "true" in the production environment only. Flip it to "false" (or
# delete it) on launch day; no code change is needed.
SITE_UNDER_CONSTRUCTION=