# Supabase — content store for the admin panel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# The Storage bucket used for gallery assets and durable menu settings.
SUPABASE_STORAGE_BUCKET=Gallery

# Admin login (set a custom password on deployed environments).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Public under-construction default, used until the admin saves Site Maintenance.
# Saved settings/site-settings.json in Supabase Storage takes precedence,
# including a saved false value. The admin toggle does not need a redeploy.
# Public pages receive live updates through /api/site/events.
#   true  — every visitor gets the under-construction page.
#           /admin and /api stay reachable so content can still be managed.
#   unset — the real site is served. Leave it unset locally and on previews.
# Use the admin Site Maintenance switch to launch or pause the site.
# Changing this default later does not override a saved admin setting.
SITE_UNDER_CONSTRUCTION=
