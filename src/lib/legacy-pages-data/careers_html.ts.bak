\"career-job-card active\" type=\"button\" role=\"tab\" aria-selected=\"true\" aria-controls=\"career-role-site-supervisor\" data-career-role=\"site-supervisor\">\n                        <span class=\"career-job-icon\"><img src=\"images/icon-service-item-1.svg\" alt=\"\"></span>\n                        <span class=\"career-job-content\">\n                            <span class=\"career-job-title\">Site Supervisor</span>\n                            <span class=\"career-job-meta\">Chennai | Full-time | Freshers & Experienced</span>\n                            <span class=\"career-job-summary\">B.E. Civil Engineering / Diploma in Civil Engineering</span>\n                        </span>\n                        <span class=\"career-job-arrow\"><img src=\"images/arrow-primary.svg\" alt=\"\"></span>\n                    </button>\n\n                    <button class=\"career-job-card\" type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"career-role-architect\" data-career-role=\"architect\">\n                        <span class=\"career-job-icon\"><img src=\"images/icon-service-item-2.svg\" alt=\"\"></span>\n                        <span class=\"career-job-content\">\n                            <span class=\"career-job-title\">Architect</span>\n                            <span class=\"career-job-meta\">Chennai | Full-time | Freshers & Experienced</span>\n                            <span class=\"career-job-summary\">B.Arch</span>\n                        </span>\n                        <span class=\"career-job-arrow\"><img src=\"images/arrow-primary.svg\" alt=\"\"></span>\n                    </button>\n\n                    <button class=\"career-job-card\" type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"career-role-qc-engineer\" data-career-role=\"qc-engineer\">\n                        <span class=\"career-job-icon\"><img src=\"images/icon-service-item-3.svg\" alt=\"\"></span>\n                        <span class=\"career-job-content\">\n                            <span class=\"career-job-title\">Quality Control (QC) Engineer</span>\n                            <span class=\"career-job-meta\">Chennai | Full-time | Freshers & Experienced</span>\n                            <span class=\"career-job-summary\">B.E. Civil Engineering / Diploma in Civil Engineering</span>\n                        </span>\n                        <span class=\"career-job-arrow\"><img src=\"images/arrow-primary.svg\" alt=\"\"></span>\n                    </button>\n                </div>\n\n                <div class=\"career-detail-panel\">\n                    <article class=\"career-role-detail active\" id=\"career-role-site-supervisor\" role=\"tabpanel\" data-career-detail=\"site-supervisor\">\n                        <div class=\"career-detail-header\">\n                            <span class=\"career-eyebrow\">Open role</span>\n                            <h2>Site Supervisor</h2>\n                            <p>B.E. Civil Engineering / Diploma in Civil Engineering</p>\n                        </div>\n                        <div class=\"career-detail-grid\">\n                            <div><span>Location</span><strong>Chennai</strong></div>\n                            <div><span>Experience</span><strong>Freshers & Experienced Candidates Can Apply</strong></div>\n                            <div><span>Employment Type</span><strong>Full-Time</strong></div>\n                        </div>\n                        <h3>Role Description</h3>\n                        <p>Responsible for supervising day-to-day site activities, coordinating with contractors and vendors, monitoring work progress, ensuring quality standards, maintaining safety compliance, and supporting timely project completion.</p>\n                        <a class=\"btn-default\" href=\"mailto:admin@intexspace.com?subject=Application%20-%20Site%20Supervisor\">Apply Now</a>\n                    </article>\n\n                    <article class=\"career-role-detail\" id=\"career-role-architect\" role=\"tabpanel\" data-career-detail=\"architect\" hidden>\n                        <div class=\"career-detail-header\">\n                            <span class=\"career-eyebrow\">Open role</span>\n                            <h2>Architect</h2>\n                            <p>B.Arch</p>\n                        </div>\n                        <div class=\"career-detail-grid\">\n                            <div><span>Location</span><strong>Chennai</strong></div>\n                            <div><span>Experience</span><strong>Freshers & Experienced Candidates Can Apply</strong></div>\n                            <div><span>Employment Type</span><strong>Full-Time</strong></div>\n                        </div>\n                        <h3>Role Description</h3>\n                        <p>Responsible for architectural planning, design development, preparation of drawings, space planning, client coordination, material selection, and ensuring project designs comply with applicable standards and requirements.</p>\n                        <a class=\"btn-default\" href=\"mailto:admin@intexspace.com?subject=Application%20-%20Architect\">Apply Now</a>\n                    </article>\n\n                    <article class=\"career-role-detail\" id=\"career-role-qc-engineer\" role=\"tabpanel\" data-career-detail=\"qc-engineer\" hidden>\n                        <div class=\"career-detail-header\">\n                            <span class=\"career-eyebrow\">Open role</span>\n                            <h2>Quality Control (QC) Engineer</h2>\n                            <p>B.E. Civil Engineering / Diploma in Civil Engineering</p>\n                        </div>\n                        <div class=\"career-detail-grid\">\n                            <div><span>Location</span><strong>Chennai</strong></div>\n                            <div><span>Experience</span><strong>Freshers & Experienced Candidates Can Apply</strong></div>\n                            <div><span>Employment Type</span><strong>Full-Time</strong></div>\n                        </div>\n                        <h3>Role Description</h3>\n                        <p>Responsible for inspecting construction activities, verifying material quality, conducting quality checks, maintaining documentation, ensuring compliance with project specifications, and supporting the delivery of high-quality projects.</p>\n                        <a class=\"btn-default\" href=\"mailto:admin@intexspace.com?subject=Application%20-%20Quality%20Control%20Engineer\">Apply Now</a>\n                    </article>\n                </div>\n            </div>\n            <div class=\"intex-career-cta dark-section wow fadeInUp\">\n                <div>\n                    <h2>Send Your Profile</h2>\n                    <p>Email your resume to <a href=\"mailto:admin@intexspace.com\">admin@intexspace.com</a> or call <a href=\"tel:044-4280 0562 / 9360126623\">044-4280 0562 / 9360126623</a>.</p>\n                </div>\n                <a href=\"contact.html\" class=\"btn-default\">Contact HR / Admin</a>\n            </div>\n        </div>\n    </div>\n    <!-- Careers Page End -->\n\n    <!-- Footer Start -->\n    <footer class=\"main-footer dark-section\">\n        <div class=\"container\">\n            <!-- Footer Header Start -->\n            <div class=\"footer-header\">\n                <div class=\"row align-items-center\">\n                    <div class=\"col-xl-9\">\n                        <!-- About Footer Start -->\n                        <div class=\"about-footer\">\n                            <!-- Footer Logo Start -->\n                            <div class=\"footer-logo\">\n                                <img src=\"images/logo.svg\" alt=\"\">\n                            </div>\n                            <!-- Footer Logo End -->\n\n                            <!-- About Footer Content Start -->\n                            <div class=\"about-footer-content\">\n                                <p>Intexspace Solutions Pvt Ltd delivers architecture, interiors, MEP, turnkey execution and facility management for banks, PSUs, healthcare, corporate, industrial, institutional and residential spaces across India.</p>\n                            </div>\n                            <!-- About Footer Content End -->\n                        </div>\n                        <!-- About Footer End -->\n                    </div>\n\n                    <div class=\"col-xl-3\">\n                        <!-- Footer Social Links Start -->\n                        <div class=\"footer-social-links\">\n                            <ul>\n                                <li><a href=\"https://www.facebook.com/IntexSpaceSolutions/\" target=\"_blank\" rel=\"noopener noreferrer\"><i class=\"fa-brands fa-facebook-f\"></i></a></li>\n                                <li><a href=\"https://in.linkedin.com/company/intex-space-solutions-pvt-ltd---india\" target=\"_blank\" rel=\"noopener noreferrer\"><i class=\"fa-brands fa-linkedin-in\"></i></a></li>\n                            </ul>\n                        </div>\n                        <!-- Footer Social Links End -->\n                    </div>\n                </div>\n            </div>\n            <!-- Footer Header End -->\n            \n            <div class=\"row\">\n                <div class=\"col-xl-4\">\n                    <!-- Footer Newsletter Box Start -->\n                    <div class=\"footer-newsletter-box\">\n                        <h3>Discuss Your Next Project</h3>\n                        <p>Share your requirement with our Chennai team for design, execution, maintenance or turnkey project support.</p>\n                        <div class=\"footer-newsletter-form\">\n                            <form id=\"newslettersForm\" action=\"#\" method=\"POST\">\n                                <div class=\"form-group\">\n                                    <input type=\"email\" name=\"mail\" class=\"form-control\" id=\"mail\" placeholder=\"Enter Email Address*\" required>\n                                    <button type=\"submit\" class=\"newsletter-btn\"><img src=\"images/arrow-white.svg\" alt=\"\"></button>\n                                </div>\n                            </form>\n                        </div>\n                    </div>\n                    <!-- Footer Newsletter Box End -->\n                </div>\n\n                <div class=\"col-xl-8\">\n                    <!-- Footer Links Box Start -->\n                    <div class=\"footer-links-box\">\n                        <!-- Footer Links Start -->\n                        <div class=\"footer-links\">\n                            <h3>Quick Links</h3>\n                            <ul>\n                                <li><a href=\"index.html\">Home</a></li>\n                                <li><a href=\"about.html\">About Us</a></li>\n                                <li><a href=\"projects.html\">Projects</a></li>\n                                <li><a href=\"careers.html\">Careers</a></li>\n                                <li><a href=\"gallery.html\">Gallery</a></li>\n                                <li><a href=\"contact.html\">Contact Us</a></li>\n                            </ul>\n                        </div>\n                        <!-- Footer Links End -->\n\n                        <!-- Footer Links Start -->\n                        <div class=\"footer-links\">\n                            <h3>Project Sections</h3>\n                            <ul>\n                                <li><a href=\"projects.html#ongoing\">Ongoing Projects</a></li>\n                                <li><a href=\"projects.html#upcoming\">Upcoming Projects</a></li>\n                                <li><a href=\"projects.html#completed\">Completed Projects</a></li>\n                                <li><a href=\"gallery.html\">Project Gallery</a></li>\n                  